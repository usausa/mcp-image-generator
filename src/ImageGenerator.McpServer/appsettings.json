{
  "http_ports": "12080",

  "AllowedHosts": "*",

  "ImageGenerator": {
    "Endpoint": "",
    "DeploymentName": "gpt-image-2",
    "ApiKey": "",
    "ApiVersion": "2025-04-01-preview",
    "OutputPath": "output",
    "InputRoots": [],
    "OutputRoots": [],
    "MaxRetries": 5,
    "RequestTimeoutMinutes": 10,
    "MaxConcurrency": 2,
    "MaxCount": 4,
    "RetentionDays": 7,
    "Defaults": {
      "Size": "1024x1024",
      "Quality": "high",
      "OutputFormat": "png",
      "OutputCompression": 80
    }
  },

  "ImageProcessing": {
    "MaxDimension": 4096,
    "JpegQuality": 80,
    "WebpQuality": 80
  },

  "Prometheus": {
    "Uri": "http://0.0.0.0:9464"
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/ImageGenerator.McpServer_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
